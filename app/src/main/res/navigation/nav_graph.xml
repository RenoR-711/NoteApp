<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.notesapp.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <!-- Action zu AddNoteFragment -->
        <action
            android:id="@+id/action_homeFragment_to_addNoteFragment"
            app:destination="@id/addNoteFragment" />

        <!-- Action zu UpdateNoteFragment -->
        <action
            android:id="@+id/action_homeFragment_to_updateNoteFragment"
            app:destination="@id/updateNoteFragment">
            <argument
                android:name="note"
                app:argType="com.example.notesapp.model.Note" />
        </action>

    </fragment>

    <fragment
        android:id="@+id/addNoteFragment"
        android:name="com.example.notesapp.fragments.AddNoteFragment"
        android:label="Add Note"
        tools:layout="@layout/fragment_add_note">
        <action
            android:id="@+id/action_addNoteFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/updateNoteFragment"
        android:name="com.example.notesapp.fragments.UpdateNoteFragment"
        android:label="Update Note">
        <argument
            android:name="note"
            app:argType="com.example.notesapp.model.Note" />
    </fragment>

</navigation>
